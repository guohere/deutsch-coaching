# ==============================================================================
# SprachCoach — Environment Configuration
# ==============================================================================
# All features (77 B1 articles, 66 Q&A reflex drills, multi-day SRS drills,
# offline dictionary lookup, audio playback) work 100% out of the box with zero keys!
#
# To unlock dynamic LLM grading and AI article/interview generation:
# Obtain free API keys below and add them here, or paste them in the in-app Settings page:
#
# Free Google Gemini API Key: https://aistudio.google.com
GEMINI_API_KEY=

# Free Groq Cloud API Key (Ultra-fast LLaMA 3.3 70B & Whisper): https://console.groq.com
GROQ_API_KEY=

# Optional: Set to true to enforce offline demo mode in public hosting
DEMO_MODE=false
